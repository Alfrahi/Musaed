{
  "name": "@musaed/contracts",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./migrations": {
      "types": "./src/migrations.ts",
      "default": "./src/migrations.ts"
    },
    "./*": {
      "types": "./src/*",
      "default": "./src/*"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint --config ../../eslint.config.mjs .",
    "type-check": "tsc --noEmit",
    "docs": "typedoc",
    "docs:serve": "npx serve docs"
  }
}
