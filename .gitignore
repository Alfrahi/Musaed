# Dependencies
node_modules/
.pnp.*
.pnpm-store/
pnpm-debug.log*

# Build outputs
.next/
out/
dist/

# Generated docs
packages/contracts/docs/

# Tauri / Rust
src-tauri/target/
src-tauri/gen/
src-tauri/**/*.log
src-tauri/Cargo.lock.bak

# Next.js static export
apps/web/out/
apps/web/.next/

# Environment files (never commit secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Temporary / Cache
.tmp/
.cache/
coverage/
*.tsbuildinfo

# Test artifacts
playwright-report/
test-results/

# Optional: If you ever generate these
**/tauri.conf.json.bak
**/*.rs.bak
**/*.ts.bak

# Keep only pnpm lockfile
!pnpm-lock.yaml
package-lock.json
yarn.lock

# Build artifacts from Tauri bundler
src-tauri/**/*.bundle
src-tauri/**/*.dmg
src-tauri/**/*.app
src-tauri/**/*.deb
src-tauri/**/*.rpm

