{
  "name": "musaed",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "license": "MIT",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "prod:build": "pnpm validate && pnpm --filter web i18n:check && pnpm --filter web prod:build && tauri build",
    "test": "pnpm --filter web test",
    "lint": "pnpm -F web exec eslint src",
    "type-check": "pnpm --filter \"*\" type-check",
    "validate": "pnpm lint && pnpm type-check && pnpm --filter web i18n:check && pnpm validate:manifests",
    "i18n:sync": "pnpm --filter web i18n:sync",
    "i18n:check": "pnpm --filter web i18n:check",
    "validate:i18n": "node scripts/validate-i18n.mjs",
    "arch-check": "pnpm -F web exec depcruise src --config ../../.dependency-cruiser.js",
    "codegen:validation": "node scripts/codegen-validation.mjs",
    "codegen:validation:check": "node scripts/codegen-validation.mjs --check",
    "codegen:feature-deps": "node scripts/codegen-feature-deps.mjs",
    "codegen:feature-deps:check": "node scripts/codegen-feature-deps.mjs --check",
    "validate:contracts": "node scripts/validate-contracts.mjs",
    "validate:acl": "node scripts/validate-ipc-acl.mjs",
    "validate:manifests": "node scripts/validate-manifests.mjs",
    "validate:manifests:check": "node scripts/validate-manifests.mjs",
    "test:contracts": "node --test scripts/validate-contracts.test.mjs",
    "test:arch": "node --test scripts/dep-cruiser-guard.test.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.4",
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^22.19.17",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.7.3",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "focus-trap-react": "^12.0.0",
    "framer-motion": "^12.38.0",
    "unified": "^11.0.5",
    "zod": "^4.3.6"
  },
  "lint-staged": {
    "apps/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "packages/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
