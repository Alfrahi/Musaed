#!/usr/bin/env sh

echo "🛡 Musaed Pre-push (thorough)"

set -e

# ── 1. Architecture boundary validation ────────────────────
echo "🧱 Checking architecture boundaries..."
pnpm codegen:feature-deps:check
pnpm arch-check
pnpm test:arch

# ── 2. Type safety ────────────────────────────────────────
echo "🔒 Running TypeScript check..."
pnpm type-check

# ── 3. i18n compliance ────────────────────────────────────
echo "🌐 Checking i18n compliance..."
pnpm --filter web i18n:check

# ── 3b. Validation constants sync ──────────────────────────
echo "🔗 Checking validation constants sync..."
pnpm codegen:validation:check

# ── 3c. IPC contract validation (baseline) ────────────────
echo "📜 Checking IPC contract validation (baseline)..."
pnpm validate:contracts

# ── 3d. IPC contract validation (strict) ──────────────────
echo "📜 Checking IPC contract validation (strict)..."
pnpm validate:contracts --strict

# ── 4. No TODOs/FIXMEs in source ──────────────────────────
echo "📝 Checking for TODOs/FIXMEs..."
if grep -rE "\bTODO\b|\bFIXME\b|\bHACK\b" apps/web/src --include="*.ts" --include="*.tsx" --exclude-dir={test,tests}; then
  echo "❌ Found TODO/FIXME comments. Resolve before pushing."
  exit 1
fi

# ── 5. Tests ──────────────────────────────────────────────
echo "🧪 Running tests..."
pnpm test

echo "✅ Pre-push passed"
