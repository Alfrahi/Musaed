#!/usr/bin/env sh

echo "🛡 Musaed Pre-commit (auto-fix enabled)"

set -e

# ── 1. Rust format & lint (only if .rs files changed) ──────
staged_rs=$(git diff --cached --name-only --diff-filter=ACM -- 'src-tauri/**/*.rs')
if [ -n "$staged_rs" ]; then
  echo "🦀 Running Rust formatting..."
  cargo fmt --all --manifest-path src-tauri/Cargo.toml

  # Re-stage any Rust files that were reformatted
  echo "$staged_rs" | xargs git add

  echo "🦀 Running Rust lint (Clippy)..."
  cargo clippy --all-targets --all-features --manifest-path src-tauri/Cargo.toml -- -D warnings
fi

# ── 2. i18n validation (only if locale files changed) ──────
staged_locales=$(git diff --cached --name-only --diff-filter=ACM -- 'apps/web/locales/*.json')
if [ -n "$staged_locales" ]; then
  echo "🌐 Validating i18n keys..."
  pnpm validate:i18n
fi

# ── 3. Lint + format staged JS/TS files ────────────────────
echo "🔧 Running lint-staged..."
pnpm exec lint-staged

echo "✅ Pre-commit passed"
