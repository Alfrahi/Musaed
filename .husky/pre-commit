#!/usr/bin/env sh

echo "🛡 Musaed Pre-commit (fast)"

set -e

# ── 1. Rust format & lint (only if .rs files changed) ──────
staged_rs=$(git diff --cached --name-only --diff-filter=ACM -- 'src-tauri/**/*.rs')
if [ -n "$staged_rs" ]; then
  echo "🦀 Running Rust checks..."
  cargo fmt --all --manifest-path src-tauri/Cargo.toml -- --check
  cargo clippy --all-targets --all-features --manifest-path src-tauri/Cargo.toml -- -D warnings
fi

# ── 2. Lint + format staged JS/TS files ────────────────────
echo "🔧 Running lint-staged..."
pnpm exec lint-staged

echo "✅ Pre-commit passed"
