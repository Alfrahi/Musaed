{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Enables only required permissions for Musaed with strict but practical filesystem scoping.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "core:window:allow-get-all-windows",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        { "path": "$PICTURE/Musaed/**/*" },
        { "path": "$DOCUMENT/Musaed/**/*" },
        { "path": "$DESKTOP/Musaed/**/*" },
        { "path": "$DOWNLOAD/Musaed/**/*" },
        { "path": "$APP_DATA/musaed/**/*" }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "$APP_DATA/musaed/**/*" },
        { "path": "$DOCUMENT/Musaed/**/*" },
        { "path": "$DESKTOP/Musaed/**/*" },
        { "path": "$DOWNLOAD/Musaed/**/*" }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        { "path": "$APP_DATA/musaed/**/*" },
        { "path": "$DOCUMENT/Musaed/**/*" },
        { "path": "$DESKTOP/Musaed/**/*" },
        { "path": "$DOWNLOAD/Musaed/**/*" }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/alfrahi/musaed/**" },
        { "url": "https://github.com/Alfrahi/Musaed/**" },
        { "url": "https://ollama.com/**" },
        { "url": "https://ollama.ai/**" },
        { "url": "mailto:*" }
      ]
    },
    "store:allow-load",
    "store:allow-set",
    "store:allow-get",
    "store:allow-save",

    "allow-ollama-commands",
    "allow-logging-commands",
    "allow-rag-commands",
    "allow-conversation-commands",
    "allow-store-commands",
    "allow-dialog-commands",
    "allow-fs-commands",
    "allow-opener-commands",
    "allow-context-menu-commands",
    "allow-app-info-commands",
    "allow-tray-commands"
  ]
}
